{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/felra-project-v0.2.schema.json",
  "title": "FELRA Project v0.2",
  "type": "object",
  "required": [
    "project",
    "parameters",
    "claims"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "properties": {
        "max_evaluations": {
          "type": "integer",
          "minimum": 1
        },
        "random_samples": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer"
        }
      }
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "float",
              "int"
            ]
          },
          "range": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          },
          "samples": {
            "type": "integer",
            "minimum": 1
          }
        },
        "anyOf": [
          {
            "required": [
              "range"
            ]
          },
          {
            "required": [
              "values"
            ]
          }
        ]
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "expression"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string"
          },
          "max_counterexamples": {
            "type": "integer",
            "minimum": 1
          },
          "required_checks": {
            "type": "array",
            "items": {
              "enum": [
                "numerical",
                "boundaries",
                "counterexample_search"
              ]
            },
            "uniqueItems": true
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "figures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "line",
                  "scatter",
                  "histogram",
                  "heatmap",
                  "contour",
                  "phase_map"
                ]
              },
              "filename": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "x": {
                "type": "string"
              },
              "y": {
                "type": "string"
              },
              "z": {
                "type": "string"
              },
              "xlabel": {
                "type": "string"
              },
              "ylabel": {
                "type": "string"
              },
              "bins": {
                "type": "integer",
                "minimum": 1
              },
              "claim_id": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
