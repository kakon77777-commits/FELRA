{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schema/felra/project-v0.3.schema.json",
  "title": "FELRA Project v0.3",
  "type": "object",
  "required": [
    "parameters",
    "claims"
  ],
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "max_evaluations": {
          "type": "integer",
          "minimum": 1
        },
        "random_samples": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "float",
              "int"
            ]
          },
          "range": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1
          },
          "samples": {
            "type": "integer",
            "minimum": 1
          }
        },
        "oneOf": [
          {
            "required": [
              "range"
            ]
          },
          {
            "required": [
              "values"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "expression"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "required_checks": {
            "type": "array",
            "items": {
              "enum": [
                "numerical",
                "boundaries",
                "counterexample_search"
              ]
            },
            "uniqueItems": true
          },
          "max_counterexamples": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "analyses": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "expression"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string"
              },
              "claim_id": {
                "type": "string"
              },
              "type": {
                "const": "sensitivity"
              },
              "expression": {
                "type": "string"
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "baseline": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "relative_step": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "absolute_step": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "reference",
              "approximation"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string"
              },
              "claim_id": {
                "type": "string"
              },
              "type": {
                "const": "residual"
              },
              "reference": {
                "type": "string"
              },
              "approximation": {
                "type": "string"
              },
              "independent": {
                "type": "string"
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              },
              "bins": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "objective"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string"
              },
              "claim_id": {
                "type": "string"
              },
              "type": {
                "const": "parameter_sweep"
              },
              "objective": {
                "type": "string"
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "fixed": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "goal": {
                "enum": [
                  "minimize",
                  "maximize"
                ]
              },
              "top_k": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "objectives"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string"
              },
              "claim_id": {
                "type": "string"
              },
              "type": {
                "const": "pareto"
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "fixed": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "objectives": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "expression"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expression": {
                      "type": "string"
                    },
                    "goal": {
                      "enum": [
                        "minimize",
                        "maximize"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "figures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "line",
                  "scatter",
                  "histogram",
                  "heatmap",
                  "contour",
                  "phase_map"
                ]
              },
              "filename": {
                "type": "string",
                "pattern": "\\.(png|svg|pdf)$"
              },
              "title": {
                "type": "string"
              },
              "x": {
                "type": "string"
              },
              "y": {
                "type": "string"
              },
              "z": {
                "type": "string"
              },
              "xlabel": {
                "type": "string"
              },
              "ylabel": {
                "type": "string"
              },
              "bins": {
                "type": "integer",
                "minimum": 1
              },
              "claim_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}