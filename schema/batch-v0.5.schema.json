{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schema/felra/batch-v0.5.schema.json",
  "title": "FELRA Batch v0.5",
  "type": "object",
  "required": [
    "experiments"
  ],
  "properties": {
    "batch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "workers": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "project"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/\\\\]+$"
          },
          "project": {
            "type": "string",
            "minLength": 1
          },
          "overrides": {
            "type": "object",
            "additionalProperties": true
          },
          "repeat": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "seed_path": {
                "type": "string",
                "minLength": 1
              },
              "seed_start": {
                "type": "integer"
              },
              "seed_step": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
