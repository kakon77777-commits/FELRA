{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FELRA synchronization report",
  "type": "object",
  "required": [
    "repository",
    "source_version",
    "target_version",
    "status",
    "branch",
    "commit_sha",
    "push",
    "remote_verified",
    "checks",
    "files_changed",
    "autonomous_fixes",
    "warnings",
    "remaining_actions"
  ],
  "properties": {
    "repository": {
      "type": "string"
    },
    "source_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "incomplete",
        "blocked",
        "rolled_back"
      ]
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "commit_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "push": {
      "type": "object",
      "required": [
        "attempted",
        "succeeded"
      ],
      "properties": {
        "attempted": {
          "type": "boolean"
        },
        "succeeded": {
          "type": "boolean"
        },
        "remote": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "remote_verified": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "unavailable"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "duration_seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "autonomous_fixes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remaining_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_artifact": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "checksum_verified": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "properties": {
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "python": {
          "type": [
            "string",
            "null"
          ]
        },
        "git": {
          "type": [
            "string",
            "null"
          ]
        },
        "felra": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
